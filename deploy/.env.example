# Copy to deploy/.env for local dev. Never commit real secrets.
APP_ENV=dev
ROLES=api,ws,worker
LOG_LEVEL=debug

POSTGRES_USER=motolink
POSTGRES_PASSWORD=motolink_dev_password
POSTGRES_DB=motolink
DATABASE_URL=postgres://motolink:motolink_dev_password@postgres:5432/motolink?sslmode=disable

REDIS_PASSWORD=redis_dev_password
REDIS_ADDR=redis:6379

# kafka (full pipeline, local/CI)   |  direct_pg + inproc (Render free profile, ADR-021)
HISTORY_SINK=kafka
OUTBOX_SINK=kafka
KAFKA_BROKERS=kafka:9092

# Leave unset in dev: an ephemeral signing key is generated (all tokens die on restart). Set a PEM path in prod.
# JWT_ED25519_PRIVATE_KEY_FILE=/run/secrets/jwt_ed25519.pem
JWT_KID=k1
ARGON2_MAX_CONCURRENCY=2
WS_MAX_CONNS=1500
WS_MAX_CONNS_PER_IP=20
DEBUG_LOG_COORDS=false

# Push (FCM HTTP v1). Empty = push disabled, notifications stay in-app only.
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=

# Retention (docs/design/05 §6)
RETENTION_FULLRES_DAYS=30
RETENTION_PARTITION_DAYS=90

# Self-hosted maps (profile "maps", see deploy/maps/README.md). Empty = feature off.
# TILE_BASE_URL must be an address the PHONE can reach (LAN IP of this machine, or your domain).
OSRM_URL=
TILE_BASE_URL=
GEOCODE_DATABASE_URL=
